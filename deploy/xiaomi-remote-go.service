[Unit]
Description=Open Voice Bridge agent (Xiaomi Remote / phone input)
After=pipewire.service pipewire-pulse.service
Wants=pipewire.service
PartOf=pipewire.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/bin/xiaomi-remote agent
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -S /tmp/.X11-unix/X0 ] && exit 0; sleep 1; done; exit 0'
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
StandardOutput=append:@ROOT@/agent.log
StandardError=append:@ROOT@/agent.log
SyslogIdentifier=xiaomi-remote
Restart=always
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
UMask=0077

[Install]
WantedBy=default.target