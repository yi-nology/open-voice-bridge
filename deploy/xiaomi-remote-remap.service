[Unit]
Description=Open Voice Bridge key remapper (root uinput helper)
After=bluetooth.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
ExecStart=@ROOT@/bin/xiaomi-remote remap
SyslogIdentifier=xiaomi-remote-remap
Restart=always
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false
PrivateTmp=true
ReadWritePaths=/etc/xiaomi-remote /run
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
RestrictRealtime=true
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target